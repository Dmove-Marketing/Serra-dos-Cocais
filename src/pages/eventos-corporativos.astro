---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/eventos-corporativos.css';
---

<Base
  title="Serra dos Cocais — Eventos Corporativos em uma fazenda histórica"
  description="Confraternizações, treinamentos e eventos corporativos em um ambiente inspirador. Estrutura completa, hospedagem e natureza em Itatiba, SP."
  ogImage="https://media.dmove.com.br/clients/serra-dos-cocais/photos/hero_corporativo_resultado.webp"
  whatsAppMessage="Olá! Como posso te ajudar com o seu evento corporativo?\nPreencha os campos abaixo e vamos conversar pelo WhatsApp."
  whatsAppStep1Fields={[
    {
      name: 'Empresa',
      type: 'text',
      label: 'Empresa',
      required: true
    },
    {
      name: 'Tipo de evento',
      type: 'select',
      label: 'Tipo de evento',
      required: false,
      options: [
        { value: '', label: 'Selecione o tipo de evento', disabled: true, selected: true },
        { value: 'Confraternização', label: 'Confraternização' },
        { value: 'Team building', label: 'Team building' },
        { value: 'Treinamento/Workshop', label: 'Treinamento/Workshop' },
        { value: 'Lançamento de produto', label: 'Lançamento de produto' },
        { value: 'Outros', label: 'Outros' }
      ]
    },
    {
      name: 'Data do evento',
      type: 'text',
      label: 'Data do evento',
      placeholder: 'dd/mm/aaaa',
      required: false
    },
    {
      name: 'Número de pessoas',
      type: 'number',
      label: 'Número de pessoas',
      required: false
    },
    {
      name: 'Detalhes adicionais',
      type: 'textarea',
      label: 'Detalhes adicionais',
      placeholder: 'Conte um pouco sobre o evento que sua empresa imagina',
      required: false
    }
  ]}
>
<div class="grain"></div>

<div class="lightbox" id="lightbox">
  <span class="lightbox-close" aria-label="Fechar">&times;</span>
  <img src="" alt="" />
  <p class="lightbox-caption"></p>
</div>

<!-- MENU -->
<nav class="site-nav" id="siteNav">
  <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/logo-serra-dos-cocais.webp" alt="Logotipo Serra dos Cocais" class="nav-logo" />
  <a class="nav-cta" href="#contato"><span class="btn-line">Planejar meu evento</span></a>
</nav>

<!-- HERO -->
<header class="hero" id="topo">
  <div class="hero-media">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/hero_corporativo_resultado.webp" alt="Evento corporativo na Serra dos Cocais em meio à natureza" priority />
  </div>
  <div class="wrap hero-content">
    <span class="cap on-dark">Itatiba · São Paulo</span>
    <h1 class="display-1">A confraternização <br>da sua empresa em <br>meio à natureza</h1>
    <p class="lead on-dark hero-lead-wide">Um ambiente inspirador para criar <br class="mobile-br">experiências memoráveis.</p>
  </div>
</header>

<!-- SOBRE -->
<section id="sobre" class="sobre-bg-section">
  <div class="section-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/sobre_corporativo_resultado.webp" alt="Ambiente da fazenda para eventos corporativos" />
  </div>
  <div class="wrap section-content reveal">
    <div class="copy-block align-right">
      <span class="cap on-dark">Sobre a fazenda</span>
      <h2 class="display-2 on-dark" style="margin-top:16px">Um lugar onde <br>natureza, estrutura <br>e hospitalidade <br>se encontram</h2>
    </div>
  </div>
</section>



<!-- INFRAESTRUTURA -->
<section id="infraestrutura">
  <div class="infra-split-full">
    <!-- Esquerda: Banner com slider de background + título -->
    <div class="infra-left reveal">
      <div class="infra-slider">
        <div class="infra-slide active"><Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/infraestrutura_corporativo01_resultado.webp" alt="Infraestrutura da fazenda 1" /></div>
        <div class="infra-slide"><Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/infraestrutura_corporativo02_resultado.webp" alt="Infraestrutura da fazenda 2" /></div>
        <div class="infra-slide"><Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/infraestrutura_corporativo03_resultado.webp" alt="Infraestrutura da fazenda 3" /></div>
      </div>
      <div class="infra-overlay"></div>
      <div class="infra-header">
        <span class="cap on-dark">Infraestrutura</span>
        <h2 class="display-2 on-dark" style="margin-top:16px">Uma estrutura <br>completa para <br>receber sua equipe</h2>
      </div>
    </div>

    <!-- Direita: Cards da estrutura em Grid 2x4 -->
    <div class="infra-right reveal">
      <div class="infra-grid">
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V10"/><path d="M12 10C12 6 9 4 5 4c0 4 2 7 7 7Z"/><path d="M12 14c0-4 3-6 7-6 0 4-2 7-7 7"/></svg></span>
          <div class="t">Áreas ao ar livre</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg></span>
          <div class="t">Iluminação em pontos fixos</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14l-1.5-5h-11L5 17Z"/><path d="M7 12l1-4h8l1 4"/><circle cx="8" cy="17" r="1.6"/><circle cx="16" cy="17" r="1.6"/></svg></span>
          <div class="t">Estacionamento amplo</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.6c2.4.2 4.3 1.8 4.9 4.4"/></svg></span>
          <div class="t">Equipe especializada</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h10v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8Z"/><path d="M16 10h2a2 2 0 0 1 0 4h-2"/><path d="M6 8c0-1.5 1-2.5 1-4M9 8c0-1.5 1-2.5 1-4M12 8c0-1.5-1-2.5-1-4"/></svg></span>
          <div class="t">Chopeira exclusiva</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="5" r="2"/><path d="M12 7v6l-4 6M12 13l4 6M6 9.5c3.8-1.4 8.2-1.4 12 0"/></svg></span>
          <div class="t">Acessibilidade</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V5a3 3 0 0 1 6 0v2M4 12h16"/></svg></span>
          <div class="t">Estrutura para staff</div>
        </div>
        <div class="infra-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span>
          <div class="t">Versatilidade de ambientes</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOSPEDAGEM -->
<section id="hospedagem">
  <!-- Foto de Tela Inteira com Texto sobreposto -->
  <div class="hosp-hero-break reveal">
    <div class="hosp-hero-bg">
      <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/hospedagem-full_corporativo_resultado.webp" alt="Hospedagem para viver a experiência por completo" />
    </div>
    <div class="hosp-hero-overlay"></div>
    <div class="wrap hosp-hero-content">
      <span class="cap on-dark">Hospedagem</span>
      <h2 class="display-2 on-dark" style="margin-top:16px;max-width:22ch">Hospedagem para <br>viver a experiência <br>por completo</h2>
      <p class="lead on-dark" style="margin-top:20px;max-width:54ch">Nossos 8 chalés acomodam até 43 hóspedes, proporcionando uma experiência completa de imersão na Serra dos Cocais.</p>
    </div>
  </div>

</section>

<!-- GALERIA FULL-BLEED (4 SEÇÕES 100VH) -->
<section id="galeria" class="galeria-full-break reveal">
  <div class="galeria-full-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/galeria_full_corporativo02.webp" alt="Um cenário que transforma qualquer encontro" />
  </div>
  <div class="galeria-full-overlay"></div>
  <div class="wrap galeria-full-content">
    <h2 class="display-2 on-dark">Um cenário <br class="desktop-br">que transforma <br class="desktop-br">qualquer encontro</h2>
  </div>
</section>

<section class="galeria-full-break reveal">
  <div class="galeria-full-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/galeria_full_corporativo04.webp" alt="Ambientes que se adaptam ao seu evento" />
  </div>
  <div class="galeria-full-overlay"></div>
  <div class="wrap galeria-full-content">
    <h2 class="display-2 on-dark">Ambientes que <br class="desktop-br">se adaptam <br class="desktop-br">ao seu evento</h2>
  </div>
</section>

<section class="galeria-full-break reveal">
  <div class="galeria-full-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/galeria_full_corporativo03.webp" alt="Mais do que um evento. Uma experiência para sua equipe" />
  </div>
  <div class="galeria-full-overlay"></div>
  <div class="wrap galeria-full-content">
    <h2 class="display-2 on-dark">Mais do que um evento. <br class="desktop-br">Uma experiência <br class="desktop-br">para sua equipe</h2>
  </div>
</section>

<section class="galeria-full-break reveal">
  <div class="galeria-full-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/galeria_full_corporativo01.webp" alt="Permaneça. Conecte-se. Viva a Serra" />
  </div>
  <div class="galeria-full-overlay"></div>
  <div class="wrap galeria-full-content">
    <h2 class="display-2 on-dark">Permaneça. <br class="desktop-br">Conecte-se. <br class="desktop-br">Viva a Serra</h2>
  </div>
</section>

<!-- CONTATO -->
<section id="contato">
  <div class="form-bg">
    <Img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/formulario_corporativo_resultado.webp" alt="Evento corporativo na Serra dos Cocais" />
  </div>
  <div class="wrap">
    <div class="form-wrap reveal">
      <div class="form-pad">
        <h2 class="display-2">Falta pouco para <br class="desktop-br">o seu evento ser <br class="desktop-br">um sucesso</h2>
        <p class="lead on-dark" style="margin-top:14px;font-size:16px">Nossa equipe está pronta para atender você e planejar cada detalhe, com toda a estrutura e flexibilidade necessária para um evento impecável e produtivo.</p>
        <LeadForm
          formId="lead-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar solicitação"
          honeypot
          fields={[
            { name: 'Nome', type: 'text', label: 'Nome', placeholder: '', required: true },
            { type: 'row', fields: [
              { name: 'WhatsApp', type: 'tel', label: 'WhatsApp', placeholder: '(11) 90000-0000', required: true },
              { name: 'E-maiI', type: 'email', label: 'E-mail', placeholder: '', required: true },
            ]},
            { name: 'Empresa', type: 'text', label: 'Empresa', placeholder: '', required: true },
            { name: 'Tipo de evento', type: 'select', label: 'Tipo de evento', required: false, options: [
              { value: '', label: 'Selecione o tipo de evento', disabled: true, selected: true },
              { value: 'Confraternização', label: 'Confraternização' },
              { value: 'Team building', label: 'Team building' },
              { value: 'Treinamento/Workshop', label: 'Treinamento/Workshop' },
              { value: 'Lançamento de produto', label: 'Lançamento de produto' },
              { value: 'Outros', label: 'Outros' }
            ]},
            { type: 'row', fields: [
              { name: 'Data do evento', type: 'text', label: 'Data do evento', placeholder: 'dd/mm/aaaa', required: false },
              { name: 'Número de pessoas', type: 'number', label: 'Número de pessoas', placeholder: '', required: false },
            ]},
            { name: 'Detalhes adicionais', type: 'textarea', label: 'Detalhes adicionais', placeholder: 'Conte um pouco sobre o evento que sua empresa imagina', required: false },
            { name: 'fonte', type: 'hidden', value: 'Formulário /eventos-corporativos' },
          ]}
        />
      </div>
    </div>
  </div>
</section>

<!-- LOCALIZAÇÃO -->
<section id="localizacao">
  <div class="wrap">
    <div class="narrow center reveal">
      <span class="cap">Localização</span>
      <h2 class="display-2" style="margin-top:16px">Uma localização <br class="desktop-br">que <br class="mobile-br">facilita a logística</h2>
      <p class="lead center" style="margin-top:16px">Hotéis próximos e fácil acesso, a apenas <br class="mobile-br">65 km de São Paulo.</p>
    </div>
    <div class="map-frame reveal">
      <iframe title="Mapa — Fazenda Serra dos Cocais, Itatiba SP" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Fazenda+Serra+dos+Cocais,+Itatiba,+SP&z=13&output=embed"></iframe>
    </div>
    <div class="map-links reveal">
      <a class="map-btn" href="https://www.google.com/maps/dir/?api=1&destination=Fazenda+Serra+dos+Cocais,+Itatiba,+SP" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#EA4335" d="M12 2C7.58 2 4 5.58 4 10c0 5.25 6.72 11.36 7.02 11.62a1.5 1.5 0 0 0 1.96 0C13.28 21.36 20 15.25 20 10c0-4.42-3.58-8-8-8Z"/>
          <circle cx="12" cy="10" r="3.4" fill="#fff"/>
        </svg>
        <span>Abrir no Google Maps</span>
      </a>
      <a class="map-btn" href="https://waze.com/ul?q=Fazenda+Serra+dos+Cocais,+Itatiba,+SP&navigate=yes" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="1" y="1" width="22" height="22" rx="6" fill="#05C8F6"/>
          <path fill="#fff" d="M12 5.2c-3.5 0-6.2 2.5-6.2 5.9 0 1.7.8 3.1 1.9 4.1-.1.6-.4 1.3-.8 1.8-.1.2 0 .4.2.4.9-.1 1.9-.4 2.6-.8.7.2 1.5.3 2.3.3 3.5 0 6.2-2.5 6.2-5.8 0-3.4-2.7-5.9-6.2-5.9Z"/>
          <circle cx="9.8" cy="10.6" r="1" fill="#05C8F6"/>
          <circle cx="14.2" cy="10.6" r="1" fill="#05C8F6"/>
        </svg>
        <span>Abrir no Waze</span>
      </a>
    </div>
    <div class="hotels reveal">
      <h3 class="display-3" style="margin-bottom:18px;font-size:19.8px">Hotéis próximos</h3>
      <div class="hotel">
        <div><div class="n">Itatiba Orion Hotel</div><div class="addr">R. Alfredo Viêira Arantes, 305 – Centro, Itatiba – SP, 13251-184</div></div>
        <span class="km">9,7 km</span>
      </div>
      <div class="hotel">
        <div><div class="n">Ibis Itatiba</div><div class="addr">Rua Mario Belloni, Av. Nossa Sra. das Graças, 20, Itatiba – SP, 13257-401</div></div>
        <span class="km">10,5 km</span>
      </div>
      <div class="hotel">
        <div><div class="n">Vinhedo Plaza Hotel</div><div class="addr">Av. Independência, 4111 – Pinheirinho, Vinhedo – SP, 13289-700</div></div>
        <span class="km">14,3 km</span>
      </div>
      <div class="hotel">
        <div><div class="n">Colonial Hotel Itatiba</div><div class="addr">R. Dr. Jorge Tibiriçá, 91 – Centro, Itatiba – SP, 13250-100</div></div>
        <span class="km">13,1 km</span>
      </div>
      <div class="hotel">
        <div><div class="n">Blue Tree Towers Valinhos</div><div class="addr">Av. Invernada, 3237, Valinhos – SP, 13271-450</div></div>
        <span class="km">20,5 km</span>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-bottom">
      <div>Eventos corporativos em fazenda histórica · Itatiba, SP</div>
      <div>© <span id="yr"></span> Serra dos Cocais. Todos os direitos reservados.</div>
      <div style="display:flex;align-items:center;gap:6px">
        <span>Desenvolvido por</span>
        <a href="https://dmove.com.br" target="_blank" rel="noopener" style="display:inline-flex;align-items:center">
          <img src="https://media.dmove.com.br/clients/serra-dos-cocais/photos/Logotipo-dmove.webp" alt="Dmove" style="height:21px;width:auto;opacity:0.65;transition:opacity 0.25s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.65" />
        </a>
      </div>
    </div>
  </div>
</footer>


</Base>
<script>
  import '../scripts/eventos-corporativos.js';
</script>
